{
  "name": "ims-sample-manager",
  "version": "1.0.0",
  "description": "IMS Sample Manager – Calculate thickness, manage sample library, build calibration curves",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.ims.sample-manager",
    "productName": "IMS Sample Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "main.js",
      "calculator.html",
      "manifest.json",
      "sw.js",
      "icon-192.png",
      "icon-512.png"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
